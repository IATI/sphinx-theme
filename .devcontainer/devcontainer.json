// For format details, see https://aka.ms/devcontainer.json. For config options, see the
// README at: https://github.com/devcontainers/templates/tree/main/src/python
{
	"name": "Python 3",
	// Or use a Dockerfile or Docker Compose file. More info: https://containers.dev/guide/dockerfile
	"image": "python:3.13",

	"containerEnv": {
		"LANG": "C.UTF-8",
		"LC_ALL": "C.UTF-8"
	  },

	// Only affects processes VS Code spawns (terminals, tasks, debug launches),
	// not the container's own bootstrap process - unlike containerEnv, so it
	// can't break basic container startup. `pip3 install --user` (below) puts
	// sphinx-build etc. in ~/.local/bin, which isn't on PATH by default.
	"remoteEnv": {
		"PATH": "/root/.local/bin:${containerEnv:PATH}"
	},
	
	// Features to add to the dev container. More info: https://containers.dev/features.
	// "features": {},

	// Use 'forwardPorts' to make a list of ports inside the container available locally.
	// "forwardPorts": [],

	// Use 'postCreateCommand' to run commands after the container is created.
	// texlive-luatex/-latex-extra/-fonts-recommended + latexmk + xindy give us
	// the LuaLaTeX toolchain the theme's PDF styling (iati_sphinx_theme/latex.py)
	// needs to actually build a PDF - see docs/pdf-styling.rst.
	"postCreateCommand": "apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends texlive-luatex texlive-latex-extra texlive-fonts-recommended latexmk xindy && rm -rf /var/lib/apt/lists/* && pip3 install --user -r requirements_dev.txt && pip3 install --user sphinx-autobuild && pip install -e .",

	// Configure tool-specific properties.
	"customizations": {
		// Configure properties specific to VS Code.
		"vscode": {
			"settings": {
				"cSpell.language": "en-GB"
			},
			"extensions": [
				"ms-azuretools.vscode-docker",
				"lextudio.restructuredtext-pack",
				"ms-python.debugpy",
				"streetsidesoftware.code-spell-checker",
				"eamodio.gitlens"
			]
		}
	}

	// Uncomment to connect as root instead. More info: https://aka.ms/dev-containers-non-root.
	// "remoteUser": "root"

}
